{
  "name": "pdf-diva",
  "productName": "PDF Diva",
  "version": "1.0.0",
  "description": "Presenter for PDF files with a speaker view",
  "main": "dist/main.js",
  "author": "Nilo Vélez",
  "license": "GPL-3.0-or-later",
  "private": true,
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:store": "npm run build && electron-builder --win appx",
    "pack": "npm run build && electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "pdfjs-dist": "^6.4.299",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
